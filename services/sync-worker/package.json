{
  "name": "@chessengram/sync-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChessEngram opaque sync-envelope store (Cloudflare Worker shape, zero runtime dependencies).",
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.node.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/worker.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2"
  }
}
