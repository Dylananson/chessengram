# Local sync testing — copy to `.env.local` (git-ignored) and fill in.
# Values come from `terraform -chdir=infra output` after `terraform apply`.
#
# Leave these UNSET for normal local work: the app then stays local-only and
# makes no network calls at all.

# Same-origin API path, proxied to the Worker by vite.config.ts (keeps the
# session cookie first-party). Use the absolute Worker URL instead if you are
# testing against a same-site deployment.
VITE_SYNC_API_BASE=/api

# Proxy target only (read by vite.config.ts, not by the app).
VITE_SYNC_PROXY_TARGET=https://<your-worker>.<your-account>.workers.dev

# Cognito (from `terraform output cognito_domain` / `cognito_client_id`).
VITE_SYNC_AUTH_AUTHORITY=https://<your-cognito-domain>.auth.<your-region>.amazoncognito.com
VITE_SYNC_AUTH_CLIENT_ID=<app client id>

# Must match a registered callback URL EXACTLY, including any trailing slash.
# Terraform registers `http://localhost:5173` (no slash) by default.
VITE_SYNC_AUTH_REDIRECT_URI=http://localhost:5173
