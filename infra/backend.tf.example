# Terraform state contains the Google OAuth client secret. Use an encrypted
# remote backend before running this against a real account. Copy this file to
# backend.tf (and keep backend.tf out of git).

# --- Option A: AWS S3 ------------------------------------------------------
# terraform {
#   backend "s3" {
#     bucket       = "your-tfstate-bucket"
#     key          = "chessreps/prod/terraform.tfstate"
#     region       = "eu-west-1"
#     encrypt      = true
#     use_lockfile = true
#   }
# }

